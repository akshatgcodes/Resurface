# Postgres (docker-compose sets this). Leave unset locally to use SQLite.
# DATABASE_URL=postgresql+psycopg://resurface:resurface@localhost:5432/resurface
# Redis for caching + the scheduler lock. Leave unset to run without a cache.
# REDIS_URL=redis://localhost:6379/0

# Password for the app. Required.
APP_PASSWORD=
# Signs the session cookie. Any long random string.
SESSION_SECRET=

FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
CROSS_SITE_COOKIES=false

# Daily digest
SCHEDULER_ENABLED=false
DIGEST_HOUR=8
DIGEST_TIMEZONE=Asia/Kolkata
DIGEST_SIZE=5
DIGEST_TO=

# SMTP. For Gmail: smtp.gmail.com, 587, your address, an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Resurface <digest@resurface.local>
