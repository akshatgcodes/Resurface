# Read by docker-compose. Copy to .env and change.
APP_PASSWORD=resurface
SESSION_SECRET=
DIGEST_TO=me@resurface.local
DIGEST_HOUR=8
DIGEST_TIMEZONE=Asia/Kolkata

# Leave these unset to deliver to Mailpit (http://localhost:8025).
